-- toast
local toast = label({ Text = "", Font = Enum.Font.GothamBlack, TextSize = if isTouch then 20 else 28, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.26, 0), Size = UDim2.new(0.8, 0, 0, 34), TextStrokeTransparency = 0.5, TextTransparency = 1, TextStrokeColor3 = C.ink, Parent = gui })
local toastSmall = label({ Text = "", Font = Enum.Font.GothamBold, TextSize = 14, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, if isTouch then -90 else -24), Size = UDim2.new(0.8, 0, 0, 20), TextColor3 = C.neon, TextTransparency = 1, TextStrokeTransparency = 1, Parent = gui })
local toastId = 0
function UI.toast(text: string, color: Color3?)
	toastId += 1
	local id = toastId
	toast.Text = text
	toast.TextColor3 = color or C.gold
	toast.TextTransparency = 0
	toast.TextStrokeTransparency = 0.5
	task.delay(2.2, function()
		if toastId == id then
			toast.TextTransparency = 1
			toast.TextStrokeTransparency = 1
		end
	end)
end
local smallId = 0
function UI.notice(text: string)
	smallId += 1
	local id = smallId
	toastSmall.Text = text
	toastSmall.TextTransparency = 0
	task.delay(4, function()
		if smallId == id then
			toastSmall.TextTransparency = 1
		end
	end)
end

-- ---------------------------------------------------------------- touch controls
local touchLayer: Frame = make("Frame", { Name = "Touch", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = hud })
local stickBase: Frame = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 28, 1, -28), Size = UDim2.new(0, 150, 0, 150), BackgroundColor3 = C.ink, BackgroundTransparency = 0.45, Active = true, Parent = touchLayer }, {
	corner(75), stroke(C.dim, 0.5, 2),
})
local knob: Frame = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 62, 0, 62), BackgroundColor3 = C.text, BackgroundTransparency = 0.2, Parent = stickBase }, { corner(31) })
local function pedal(text: string, size: Vector2, pos: UDim2, color: Color3): TextButton
	return button(text, false, { AnchorPoint = Vector2.new(1, 1), Position = pos, Size = UDim2.new(0, size.X, 0, size.Y), BackgroundColor3 = color, BackgroundTransparency = 0.35, TextSize = 16, AutoButtonColor = false, Parent = touchLayer })
end
local gasBtn = pedal("GAS", Vector2.new(104, 120), UDim2.new(1, -24, 1, -24), Color3.fromRGB(40, 140, 90))
local brakeBtn = pedal("BRAKE", Vector2.new(86, 92), UDim2.new(1, -140, 1, -24), Color3.fromRGB(150, 50, 60))
local hbBtn = pedal("HB", Vector2.new(104, 62), UDim2.new(1, -24, 1, -156), C.panel)

local stickInput: InputObject? = nil
local held: { [InputObject]: string } = {}
local function recomputePedals()
	local t = Input.touch
	t.throttle, t.brake, t.handbrake = 0, 0, false
	for _, what in held do
		if what == "gas" then
			t.throttle = 1
		elseif what == "brake" then
			t.brake = 1
		elseif what == "hb" then
			t.handbrake = true
		end
	end
	gasBtn.BackgroundTransparency = if t.throttle > 0 then 0.05 else 0.35
	brakeBtn.BackgroundTransparency = if t.brake > 0 then 0.05 else 0.35
	hbBtn.BackgroundTransparency = if t.handbrake then 0.05 else 0.35
end
local function bindPedal(b: GuiObject, what: string)
	b.InputBegan:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.Touch or io.UserInputType == Enum.UserInputType.MouseButton1 then
			held[io] = what
			recomputePedals()
		end
	end)
end
bindPedal(gasBtn, "gas")
bindPedal(brakeBtn, "brake")
bindPedal(hbBtn, "hb")
local function setStick(pos: Vector3)
	local centre = stickBase.AbsolutePosition + stickBase.AbsoluteSize / 2
	local r = stickBase.AbsoluteSize.X / 2
	local dx = math.clamp((pos.X - centre.X) / r, -1, 1)
	local dy = math.clamp((pos.Y - centre.Y) / r, -1, 1)
	knob.Position = UDim2.new(0.5, dx * r * 0.7, 0.5, dy * r * 0.35)
	Input.touch.steer = if math.abs(dx) < 0.08 then 0 else dx
	Input.touch.steerActive = true
end
stickBase.InputBegan:Connect(function(io)
	if io.UserInputType == Enum.UserInputType.Touch or io.UserInputType == Enum.UserInputType.MouseButton1 then
		stickInput = io
		setStick(io.Position)
	end
end)
UserInputService.InputChanged:Connect(function(io)
	if io == stickInput then
		setStick(io.Position)
	elseif stickInput and stickInput.UserInputType == Enum.UserInputType.MouseButton1 and io.UserInputType == Enum.UserInputType.MouseMovement then
		setStick(io.Position)
	end
end)
UserInputService.TouchMoved:Connect(function(io)
	if io == stickInput then
		setStick(io.Position)
	end
end)
local function release(io: InputObject)
	if io == stickInput or (stickInput and stickInput.UserInputType == io.UserInputType and io.UserInputType == Enum.UserInputType.MouseButton1) then
		stickInput = nil
		knob.Position = UDim2.fromScale(0.5, 0.5)
		Input.touch.steer = 0
		Input.touch.steerActive = false
	end
	for h in held do
		if h == io or (h.UserInputType == Enum.UserInputType.MouseButton1 and io.UserInputType == Enum.UserInputType.MouseButton1) then
			held[h] = nil
		end
	end
	recomputePedals()
end
UserInputService.InputEnded:Connect(release)
UserInputService.TouchEnded:Connect(function(io)
	release(io)
end)

-- ---------------------------------------------------------------- screens
local function selectFor(obj: GuiObject?)
	if Input.lastDevice == "gamepad" then
		GuiService.SelectedObject = obj
	end
end

function UI.showTitle()
	title.Visible, garage.Visible, hud.Visible = true, false, false
	selectFor(playBtn)
end

function UI.showGarage()
	title.Visible, garage.Visible, hud.Visible = false, true, false
	showCar(profile.selected)
	selectFor(cards[profile.selected])
end

function UI.showHUD()
	title.Visible, garage.Visible, hud.Visible = false, false, true
	touchLayer.Visible = isTouch or Input.lastDevice == "touch"
	GuiService.SelectedObject = nil
end

function UI.setProfile(p: Profile)
	profile = p
	titleStats.Text = string.format("CR %s   ·   BEST %s", fmt(p.credits), fmt(p.best))
	hudCredits.Text = "CR " .. fmt(p.credits)
	easyBtn.Text = if p.easyDrift then "EASY DRIFT: ON" else "EASY DRIFT: OFF"
	easyBtn.TextColor3 = if p.easyDrift then C.neon else C.dim
	if garage.Visible then
		refreshGarage()
	end
end

function UI.setMapReady(ready: boolean)
	status.Text = if ready then "" else "Building the mountain pass…"
	playBtn.AutoButtonColor = ready
	playBtn.BackgroundTransparency = if ready then 0 else 0.6
end

export type DriftView = { active: boolean, score: number, mult: number, tags: { string } }
function UI.updateHUD(tel: any, drift: DriftView, myCar: Model?)
	speedLbl.Text = tostring(math.floor(tel.kmh + 0.5))
	gearLbl.Text = tel.gear
	local frac = math.clamp(tel.rpm / tel.red, 0, 1)
	rpmFill.Size = UDim2.fromScale(frac, 1)
	rpmFill.BackgroundColor3 = if frac > 0.88 then C.danger elseif frac > 0.7 then C.gold else C.neon
	rpmLbl.Text = fmt(math.floor(tel.rpm / 50) * 50) .. " rpm"
	driftBox.Visible = drift.active
	if drift.active then
		local total = math.floor(drift.score * drift.mult)
		dTier.Text = Config.tierFor(total)
		dScore.Text = fmt(drift.score)
		dMult.Text = string.format("×%.1f", drift.mult)
		dTags.Text = table.concat(drift.tags, "  ·  ")
	end
	updateMinimap(myCar)
end

return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Visuals</string>
            <string name="Source"><![CDATA[--!strict
-- Per-frame cosmetics for every car on the server (not just ours): wheel suspension/steer/spin,
-- steering wheel, tyre smoke, skid marks, engine pitch and tyre squeal. Runs on each client.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Kaido")
local Config = require(Shared:WaitForChild("Config"))
local Cars = require(Shared:WaitForChild("Cars"))
local CarBuilder = require(Shared:WaitForChild("CarBuilder"))
local Drive = require(script.Parent:WaitForChild("Drive"))

local Visuals = {}

type WheelVis = { part: BasePart, joint: Weld, x: number, z: number, front: boolean, spin: number, last: Vector3? }
type CarVis = {
	model: Model,
	chassis: BasePart,
	spec: Cars.Car,
	geo: CarBuilder.Geometry,
	wheels: { WheelVis },
	emitters: { ParticleEmitter },
	engine: Sound?,
	skid: Sound?,
	steerWeld: Weld?,
	steerBase: CFrame?,
	steer: number,
}

local tracked: { [Model]: CarVis } = {}
local localPlayer = Players.LocalPlayer

local skidFolder = Instance.new("Folder")
skidFolder.Name = "KaidoSkids"
skidFolder.Parent = Workspace
local skidPool: { BasePart } = {}
local skidIndex = 0
local MAX_SKIDS = 700

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

local function skidMark(a: Vector3, b: Vector3, normal: Vector3, alpha: number)
	local len = (b - a).Magnitude
	if len < 0.2 or len > 8 then
		return
	end
	skidIndex = skidIndex % MAX_SKIDS + 1
	local p = skidPool[skidIndex]
	if not p then
		local np = Instance.new("Part")
		np.Anchored = true
		np.CanCollide = false
		np.CanQuery = false
		np.CanTouch = false
		np.CastShadow = false
		np.Material = Enum.Material.SmoothPlastic
		np.Color = Color3.fromRGB(12, 12, 12)
		np.Parent = skidFolder
		skidPool[skidIndex] = np
		p = np
	end
	local mid = (a + b) / 2 + normal * 0.04
	p.Size = Vector3.new(0.75, 0.04, len + 0.1)
	p.CFrame = CFrame.lookAt(mid, mid + (b - a), normal)
	p.Transparency = 1 - alpha
end

local function track(model: Model)
	if tracked[model] then
		return
	end
	local chassis = model:WaitForChild("Chassis", 5) :: BasePart?
	if not chassis then
		return
	end
	local id = model:GetAttribute("CarId") :: string?
	local spec = Cars.get(id)
	local geo = CarBuilder.geometry(spec)
	local vis: CarVis = {
		model = model,
		chassis = chassis,
		spec = spec,
		geo = geo,
		wheels = {},
		emitters = {},
		engine = chassis:FindFirstChild("Engine") :: Sound?,
		skid = chassis:FindFirstChild("Skid") :: Sound?,
		steer = 0,
	}
	for _, wd in geo.wheels do
		local part = model:WaitForChild(wd.name, 5) :: BasePart?
		local joint = part and part:WaitForChild("Joint", 5) :: Weld?
		if part and joint then
			table.insert(vis.wheels, { part = part, joint = joint, x = wd.x, z = wd.z, front = wd.front, spin = 0 })
		end
	end
	for _, d in chassis:GetDescendants() do
		if d:IsA("ParticleEmitter") then
			table.insert(vis.emitters, d)
		end
	end
	local sw = model:FindFirstChild("SteeringWheel")
	if sw then
		vis.steerWeld = sw:FindFirstChild("SteerWeld") :: Weld?
		vis.steerBase = sw:GetAttribute("BaseC0") :: CFrame?
	end
	local engine = vis.engine
	if engine and engine.SoundId ~= "" then
		engine:Play()
	end
	local skid = vis.skid
	if skid and skid.SoundId ~= "" then
		skid:Play()
	end
	tracked[model] = vis
end

local function update(dt: number)
	local map = Workspace:FindFirstChild("KaidoMap")
	local road = map and map:FindFirstChild("Road")
	if not road then
		return
	end
	rayParams.FilterDescendantsInstances = { road, Workspace.Terrain }
	local camPos = Workspace.CurrentCamera.CFrame.Position

	for model, vis in tracked do
		if not model.Parent or not vis.chassis.Parent then
			tracked[model] = nil
			continue
		end
		local chassis = vis.chassis
		local cf = chassis.CFrame
		local far = (cf.Position - camPos).Magnitude > 600
		local v = chassis.AssemblyLinearVelocity
		local vF = v:Dot(cf.LookVector)
		local vL = v:Dot(cf.RightVector)
		local planar = math.sqrt(vF * vF + vL * vL)
		local kmh = planar * Config.KMH_PER_SPS
		local slip = if vF > 1 and planar > 4 then math.abs(math.deg(math.atan2(vL, vF))) else 0
		local mine = model == Drive.model
		local steerAngle, rpm, handbrake, throttle
		if mine then
			local tel = Drive.telemetry
			steerAngle, rpm, handbrake, throttle = tel.steerAngle, tel.rpm, tel.handbrake, tel.throttle
		else
			local s = (model:GetAttribute("Steer") :: number?) or 0
			vis.steer += (s - vis.steer) * math.min(1, dt * 10)
			steerAngle = vis.steer * math.rad(vis.spec.lock)
			rpm = (model:GetAttribute("Rpm") :: number?) or 900
			handbrake, throttle = false, 0.5
		end
		local sliding = kmh > 20 and (slip > 12 or (handbrake and kmh > 25))
		local intensity = if sliding then math.clamp((slip - 8) / 30, 0.35, 1) else 0

		-- wheels
		local geo = vis.geo
		local R = geo.radius
		for _, wv in vis.wheels do
			local yLocal = geo.originY - geo.restLen
			local contact: Vector3? = nil
			local normal = Vector3.yAxis
			if not far then
				local origin = cf:PointToWorldSpace(Vector3.new(wv.x, geo.originY, wv.z))
				local hit = Workspace:Raycast(origin, -cf.UpVector * (geo.restLen + R), rayParams)
				if hit then
					yLocal = geo.originY - (hit.Position - origin).Magnitude + R
					contact = hit.Position
					normal = hit.Normal
				end
			end
			wv.spin = (wv.spin - vF / R * dt) % (2 * math.pi)
			local rot = CFrame.Angles(wv.spin, 0, 0)
			if wv.front then
				rot = CFrame.Angles(0, -steerAngle, 0) * rot
			end
			wv.joint.C0 = CFrame.new(wv.x, yLocal, wv.z) * rot
			-- skid marks from the rear tyres (and fronts at big angle)
			if contact and sliding and (not wv.front or slip > 30) then
				local last = wv.last
				if last then
					skidMark(last, contact, normal, 0.35 + 0.45 * intensity)
				end
				wv.last = contact
			else
				wv.last = nil
			end
		end

		-- steering wheel
		local sw, base = vis.steerWeld, vis.steerBase
		if sw and base then
			sw.C0 = base * CFrame.Angles(-steerAngle * 6, 0, 0)
		end

		-- smoke
		for _, e in vis.emitters do
			e.Rate = if sliding then 25 + 70 * intensity else 0
		end

		-- sound
		local engine = vis.engine
		if engine and engine.IsPlaying then
			engine.PlaybackSpeed = math.clamp(rpm / Config.ENGINE_BASE_RPM, 0.35, 3)
			engine.Volume = (if mine then 0.35 else 0.25) + 0.3 * throttle
		end
		local skid = vis.skid
		if skid and skid.IsPlaying then
			skid.Volume += ((if sliding then 0.25 + 0.35 * intensity else 0) - skid.Volume) * math.min(1, dt * 8)
		end
	end
end

function Visuals.start()
	local folder = Workspace:WaitForChild("Cars")
	folder.ChildAdded:Connect(function(c)
		if c:IsA("Model") then
			task.spawn(track, c)
		end
	end)
	for _, c in folder:GetChildren() do
		if c:IsA("Model") then
			task.spawn(track, c)
		end
	end
	RunService.RenderStepped:Connect(update)
	local _ = localPlayer
end

-- other cars currently drifting within `radius` of `pos` (for the TANDEM bonus)
function Visuals.tandem(pos: Vector3, radius: number): boolean
	for model, vis in tracked do
		if model ~= Drive.model and model:GetAttribute("Drift") and (vis.chassis.Position - pos).Magnitude < radius then
			return true
		end
	end
	return false
end

return Visuals
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="TextChatService" referent="23">
    <Properties>
      <string name="Name">TextChatService</string>
      <token name="ChatVersion">1</token>
    </Properties>
  </Item>
  <Item class="Workspace" referent="24">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">52</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
