      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">CarModel</string>
          <string name="Source"><![CDATA[-- Kaido Drift (Roblox): builds a car out of parts. Front of the car is local -Z (CFrame.lookAt forward).
local CarModel = {}

local function part(model, name, size, offset, color, material, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then p.Shape = shape end
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.Massless = true, false, false, false, true
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p:SetAttribute("Offset", offset)
	p.Parent = model
	return p
end

-- returns the model; parts carry an "Offset" CFrame relative to the car's ground point
function CarModel.build(car, name: string)
	local m = Instance.new("Model")
	m.Name = name
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 1, 1)
	root.Transparency = 1
	root.Anchored, root.CanCollide, root.CanQuery, root.CanTouch = true, false, false, false
	root.Parent = m
	m.PrimaryPart = root

	local body, dark = car.color, Color3.fromRGB(18, 18, 22)
	local glass = Color3.fromRGB(40, 52, 66)
	local paint = Enum.Material.SmoothPlastic
	-- lower body, nose and tail
	part(m, "Body", Vector3.new(6.4, 1.7, 14.4), CFrame.new(0, 2.0, 0), body, paint)
	part(m, "Hood", Vector3.new(6.2, 0.5, 4.6), CFrame.new(0, 3.0, -4.6) * CFrame.Angles(math.rad(-4), 0, 0), body, paint)
	part(m, "Deck", Vector3.new(6.2, 0.5, 3.2), CFrame.new(0, 3.0, 5.3), body, paint)
	-- cabin with glass and roof
	local cabin = part(m, "Cabin", Vector3.new(5.6, 1.6, 6.0), CFrame.new(0, 3.6, 0.9), glass, Enum.Material.Glass)
	cabin.Transparency = 0.25
	cabin:SetAttribute("Cabin", true)
	local roof = part(m, "Roof", Vector3.new(5.4, 0.35, 4.6), CFrame.new(0, 4.55, 1.1), car.two or body, paint)
	roof:SetAttribute("Cabin", true)
	-- bumpers, side skirts
	part(m, "FrontBumper", Vector3.new(6.5, 1.1, 0.7), CFrame.new(0, 1.55, -7.3), car.two or body, paint)
	part(m, "RearBumper", Vector3.new(6.5, 1.1, 0.7), CFrame.new(0, 1.55, 7.3), car.two or body, paint)
	part(m, "Grille", Vector3.new(3.2, 0.5, 0.2), CFrame.new(0, 1.8, -7.7), dark)
	-- lights
	local hl = Color3.fromRGB(255, 244, 214)
	part(m, "HeadL", Vector3.new(1.4, 0.45, 0.2), CFrame.new(-2.3, 2.45, -7.25), hl, Enum.Material.Neon)
	part(m, "HeadR", Vector3.new(1.4, 0.45, 0.2), CFrame.new(2.3, 2.45, -7.25), hl, Enum.Material.Neon)
	local tl = Color3.fromRGB(255, 30, 40)
	part(m, "TailL", Vector3.new(1.6, 0.5, 0.2), CFrame.new(-2.2, 2.45, 7.25), tl, Enum.Material.Neon)
	part(m, "TailR", Vector3.new(1.6, 0.5, 0.2), CFrame.new(2.2, 2.45, 7.25), tl, Enum.Material.Neon)
	if car.wing then
		part(m, "Wing", Vector3.new(6.0, 0.25, 1.2), CFrame.new(0, 4.1, 6.4), car.two or body, paint)
		part(m, "WingL", Vector3.new(0.25, 0.9, 0.8), CFrame.new(-2.4, 3.6, 6.4), dark)
		part(m, "WingR", Vector3.new(0.25, 0.9, 0.8), CFrame.new(2.4, 3.6, 6.4), dark)
	end
	-- wheels (cylinders lie along X)
	for _, w in { { "WFL", -3.05, -4.6 }, { "WFR", 3.05, -4.6 }, { "WRL", -3.05, 4.6 }, { "WRR", 3.05, 4.6 } } do
		local t = part(m, w[1], Vector3.new(1.3, 2.7, 2.7), CFrame.new(w[2], 1.35, w[3]), dark, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
		t:SetAttribute("Front", w[3] < 0)
		local rim = part(m, w[1] .. "Rim", Vector3.new(1.35, 1.7, 1.7), CFrame.new(w[2] + (w[2] > 0 and 0.05 or -0.05), 1.35, w[3]), Color3.fromRGB(170, 172, 180), Enum.Material.Metal, Enum.PartType.Cylinder)
		rim:SetAttribute("Front", w[3] < 0)
	end
	-- headlight beams and rear smoke points on the root
	local beam = Instance.new("SpotLight")
	beam.Face = Enum.NormalId.Front
	beam.Range, beam.Angle, beam.Brightness = 70, 70, 4
	beam.Color = Color3.fromRGB(255, 236, 200)
	beam.Parent = root
	for _, s in { { "SmokeL", -3.0 }, { "SmokeR", 3.0 } } do
		local a = Instance.new("Attachment")
		a.Name = s[1]
		a.Position = Vector3.new(s[2], 0.6, 4.8)
		a.Parent = root
	end
	return m
end

-- place the car: ground point cf; front wheels turned by steer (radians, positive = right)
function CarModel.place(m: Model, cf: CFrame, steer: number)
	local root = m.PrimaryPart :: BasePart
	root.CFrame = cf
	for _, p in m:GetChildren() do
		if p:IsA("BasePart") and p ~= root then
			local off = p:GetAttribute("Offset") :: CFrame
			if p:GetAttribute("Front") then
				local pos = off.Position
				p.CFrame = cf * CFrame.new(pos) * CFrame.Angles(0, -steer, 0)
			else
				p.CFrame = cf * off
			end
		end
	end
end

-- hide the cabin for the first-person view
function CarModel.setCabinVisible(m: Model, visible: boolean)
	for _, p in m:GetChildren() do
		if p:IsA("BasePart") and p:GetAttribute("Cabin") then
			p.LocalTransparencyModifier = visible and 0 or 1
		end
	end
end

return CarModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">CarPhysics</string>
          <string name="Source"><![CDATA[--!strict
-- Drift car physics for Kaido Drift (Roblox). Pure maths, no Roblox APIs, so it can be tested outside Studio.
-- Units are studs and seconds. Mass is 1, so forces are accelerations.
-- Two-axle model: front and rear tyre slip angles, a driven rear axle that loses side grip when it spins,
-- weight transfer, a hand brake, and the "Easy drift" assist (drift entry, throttle feed, countersteer).

local CarPhysics = {}

local G = 34.3 -- 9.81 m/s² at 3.5 studs per metre
local A, B = 4.5, 4.5 -- centre of mass to front / rear axle
local WB = A + B
local HCG = 1.7
local IZ = A * B * 1.1
local APK = 0.14 -- slip angle (rad) where a tyre grips hardest

local function curve(s: number): number
	return math.sin(1.35 * math.atan(2.36 * s)) -- peaks at s = 1, then slides at ~85 %
end

local function sign(x: number): number
	return if x > 0 then 1 elseif x < 0 then -1 else 0
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

export type State = {
	x: number, z: number, h: number, -- position and heading (forward = (sin h, cos h))
	vx: number, vz: number, r: number, -- world velocity and yaw rate (positive = turning right)
	delta: number, -- front wheel angle (positive = right)
	ax: number, -- smoothed longitudinal acceleration (weight transfer)
	entryT: number, entryDir: number, entryArmed: boolean, bPrev: number,
	-- outputs
	u: number, speed: number, beta: number, sliding: number, spin: boolean,
}

export type Car = { power: number, grip: number, drag: number, lock: number }
export type Input = { thr: number, brk: number, hand: boolean, steer: number }

function CarPhysics.new(x: number, z: number, h: number): State
	return {
		x = x, z = z, h = h, vx = 0, vz = 0, r = 0, delta = 0, ax = 0,
		entryT = 0, entryDir = 0, entryArmed = true, bPrev = 0,
		u = 0, speed = 0, beta = 0, sliding = 0, spin = false,
	}
end

function CarPhysics.step(s: State, inp: Input, car: Car, easy: boolean, dt: number)
	local fx, fz = math.sin(s.h), math.cos(s.h)
	local rx, rz = -fz, fx -- right-hand side of the car
	local u = s.vx * fx + s.vz * fz
	local v = s.vx * rx + s.vz * rz
	local sp = math.sqrt(u * u + v * v)
	local au = math.max(math.abs(u), 3)
	local thr, brk = inp.thr, inp.brk

	local reverse = brk > 0.2 and thr < 0.1 and u < 1
	local betaR = math.atan2(v - s.r * B, au)
	local betaF = math.atan2(v + s.r * A, au)
	local beta = if sp > 3 then math.atan2(v, au) else 0
	local sliding = math.clamp((math.abs(betaR) - 0.08) / 0.15, 0, 1)

	-- Easy drift: ease the gas off past ~26° of slide so a held gas button holds the angle
	if easy and thr > 0.05 and math.abs(beta) > 0.45 then
		thr *= math.clamp(1 - (math.abs(beta) - 0.45) / 0.4, 0.3, 1)
	end
	-- Easy drift: a firm steer with the gas on kicks the rear out (once per steer input)
	if easy and u > 25 and u < 160 and thr > 0.6 and math.abs(inp.steer) > 0.65 and s.entryArmed and math.abs(betaR) < 0.12 then
		s.entryT, s.entryDir, s.entryArmed = 0.45, sign(inp.steer), false
	end
	if math.abs(inp.steer) < 0.3 or thr < 0.1 then s.entryArmed = true end
	s.entryT = math.max(0, s.entryT - dt)
	local eK = if easy then s.entryT / 0.45 else 0

	-- steering: less lock at speed unless sliding; countersteer assist follows the front of the car
	local lock = car.lock
	local maxSteer = lerp(lock / (1 + (math.max(u, 0) / 70) ^ 1.5), lock, sliding)
	local target = inp.steer * maxSteer
	local oversteer = sign(betaF) == -sign(s.r)
	if easy and oversteer and u > 5 then target += 0.95 * sliding * betaF end
	if not easy and oversteer and u > 5 then target += 0.35 * sliding * betaF end
	target = math.clamp(target, -lock, lock)
	s.delta += math.clamp(target - s.delta, -7 * dt, 7 * dt)

	-- axle loads with weight transfer
	local Fzf = math.max(0.1, G * B / WB - s.ax * HCG / WB)
	local Fzr = math.max(0.1, G * A / WB + s.ax * HCG / WB)

	-- front tyres
	local alphaF = math.atan2(v + s.r * A, au) - s.delta
	local Fyf = -car.grip * Fzf * curve(alphaF / APK)

	-- rear tyres: drive, wheelspin, hand brake
	local muR = car.grip * 1.02 * (1 - 0.6 * eK)
	if inp.hand then muR *= 0.4 end
	local capR = muR * Fzr
	local Fxr, latCap = 0, capR
	if reverse then
		Fxr = -brk * G * 0.22
	else
		local demand = thr * math.min(car.power / math.max(au, 6), capR * 1.8)
		local k = demand / capR
		Fxr = math.min(demand, capR)
		latCap = if k >= 1 then capR * 0.32 else capR * math.sqrt(1 - math.min(k, 0.97) ^ 2)
	end
	s.spin = not reverse and thr > 0.05 and Fxr >= capR * 0.999
	if inp.hand and math.abs(u) > 1 then Fxr -= sign(u) * capR * 0.6; latCap *= 0.45 end
	local alphaR = math.atan2(v - s.r * B, au)
	local Fyr = -latCap * curve(alphaR / APK)

	-- brakes, drag, rolling
	local Fb = if reverse then 0 else brk * G * 0.95
	local Fx = Fxr - Fyf * math.sin(s.delta) - car.drag * u * math.abs(u) - sign(u) * (0.4 + math.min(Fb, math.abs(u) / dt))
	local Fy = Fyr + Fyf * math.cos(s.delta)
	local Mz = A * Fyf * math.cos(s.delta) - B * Fyr

	if eK > 0 then Mz += s.entryDir * eK * IZ * 3.2 end
	local bRate = (betaR - s.bPrev) / dt
	s.bPrev = betaR
	if sliding > 0 then Mz += (if easy then 2.4 else 0.6) * sliding * IZ * math.clamp(bRate, -4, 4) end
	if easy and math.abs(beta) > 1.05 and sp > 5 then Mz -= sign(s.r) * IZ * 6 * (math.abs(beta) - 1.05) end

	s.vx += (Fx * fx + Fy * rx) * dt
	s.vz += (Fx * fz + Fy * rz) * dt
	s.r += Mz / IZ * dt
	if sp < 2 then s.r *= 1 - math.min(1, (2 - sp) * 3 * dt) end
	s.h -= s.r * dt
	s.x += s.vx * dt
	s.z += s.vz * dt
	s.ax += (Fx - s.ax) * math.min(1, dt * 10)
	if sp < 0.6 and thr < 0.05 and (brk > 0.05 or inp.hand) then s.vx, s.vz, s.r = 0, 0, 0 end

	s.u, s.speed, s.beta, s.sliding = u, sp, beta, sliding
end

-- km/h from studs per second
function CarPhysics.kmh(speed: number): number
	return speed / 3.5 * 3.6
end

return CarPhysics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Kaido Drift (Roblox): cars and shared settings.
local Config = {}

Config.ROAD_HALF = 15 -- half the road width in studs
Config.SEG = 10 -- road segment length in studs

-- Fictional JDM-style cars. power = drive, grip = tyre grip, top = top speed (km/h), lock = steering lock (rad)
Config.Cars = {
	{ id = "ps13", name = "Hoshi PS13 Spirit", price = 0, power = 900, grip = 1.00, top = 190, lock = 0.62, color = Color3.fromRGB(236, 236, 240), wing = false },
	{ id = "ae8", name = "Kaze AE8 Trueno", price = 12000, power = 760, grip = 1.06, top = 175, lock = 0.66, color = Color3.fromRGB(240, 240, 240), wing = false, two = Color3.fromRGB(30, 30, 34) },
	{ id = "fc3", name = "Rota FC3 Seven", price = 25000, power = 1050, grip = 1.03, top = 205, lock = 0.64, color = Color3.fromRGB(196, 28, 36), wing = true },
	{ id = "jzx", name = "Toyo JZX Chaser", price = 45000, power = 1250, grip = 1.00, top = 220, lock = 0.62, color = Color3.fromRGB(28, 40, 74), wing = false },
	{ id = "z33", name = "Fair Z33", price = 60000, power = 1400, grip = 1.06, top = 235, lock = 0.63, color = Color3.fromRGB(240, 120, 20), wing = true },
	{ id = "r34", name = "Skyward R34", price = 95000, power = 1650, grip = 1.10, top = 250, lock = 0.62, color = Color3.fromRGB(30, 70, 190), wing = true },
}

function Config.car(id: string)
	for _, c in Config.Cars do
		if c.id == id then return c end
	end
	return Config.Cars[1]
end

-- physics numbers for a car (drag set so top speed matches)
function Config.physics(c)
	local top = c.top / 3.6 * 3.5
	return { power = c.power, grip = c.grip, drag = c.power / (top ^ 3), lock = c.lock }
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Track</string>
          <string name="Source"><![CDATA[-- Kaido Drift (Roblox): the course. A closed loop through hairpins and S-bends (the browser game's
-- Kojiri layout, scaled to studs), with smooth climbs and drops. Server and client both build it from
-- the same numbers, so the car never needs the map parts to know where the road is.
local Config = require(script.Parent.Config)

local Track = {}

local CP = {
	{ -718.3, 279.1 }, { -688.5, 20.3 }, { -628.0, -233.0 }, { -534.2, -427.7 }, { -395.7, -502.3 }, { -275.5, -434.9 },
	{ -136.2, -476.3 }, { -47.4, -605.9 }, { 119.8, -655.6 }, { 223.7, -571.3 }, { 203.4, -456.0 }, { 294.5, -374.0 },
	{ 400.0, -447.8 }, { 448.1, -571.3 }, { 585.2, -599.9 }, { 669.5, -479.5 }, { 616.9, -330.3 }, { 680.1, -240.0 },
	{ 717.0, -75.1 }, { 661.7, 14.2 }, { 603.7, 43.6 }, { 543.5, -26.5 }, { 495.0, -50.9 }, { 445.2, -30.6 },
	{ 408.3, 28.9 }, { 426.8, 111.4 }, { 462.5, 170.5 }, { 439.6, 225.8 }, { 369.9, 246.5 }, { 306.3, 195.7 },
	{ 260.7, 154.7 }, { 207.7, 178.3 }, { 183.9, 253.3 }, { 177.9, 437.1 }, { 61.2, 574.9 }, { -110.5, 650.3 },
	{ -294.2, 644.3 }, { -438.8, 566.0 }, { -594.0, 472.6 }, { -697.9, 388.3 },
}
local SCALE = 3.5

-- closed Catmull-Rom through the control points, sampled densely
local dense = {}
local n = #CP
for i = 1, n do
	local p0, p1, p2, p3 = CP[(i - 2) % n + 1], CP[i], CP[i % n + 1], CP[(i + 1) % n + 1]
	for k = 0, 39 do
		local t = k / 40
		local t2, t3 = t * t, t * t * t
		local function cr(a, b, c, d)
			return 0.5 * (2 * b + (-a + c) * t + (2 * a - 5 * b + 4 * c - d) * t2 + (-a + 3 * b - 3 * c + d) * t3)
		end
		table.insert(dense, { cr(p0[1], p1[1], p2[1], p3[1]) * SCALE, cr(p0[2], p1[2], p2[2], p3[2]) * SCALE })
	end
end

-- resample at an even spacing
local px, pz = {}, {}
do
	local acc, seg = 0, Config.SEG
	px[1], pz[1] = dense[1][1], dense[1][2]
	for i = 1, #dense do
		local a, b = dense[i], dense[i % #dense + 1]
		local dx, dz = b[1] - a[1], b[2] - a[2]
		local len = math.sqrt(dx * dx + dz * dz)
		local pos = 0
		while acc + (len - pos) >= seg do
			pos += seg - acc
			acc = 0
			local f = pos / len
			table.insert(px, a[1] + dx * f)
			table.insert(pz, a[2] + dz * f)
		end
		acc += len - pos
	end
	-- drop a final point that lands on top of the start
	local l = #px
	if math.sqrt((px[l] - px[1]) ^ 2 + (pz[l] - pz[1]) ^ 2) < seg * 0.5 then
		table.remove(px)
		table.remove(pz)
	end
end

local N = #px
-- centre the course on the origin
local cx, cz = 0, 0
for i = 1, N do cx += px[i]; cz += pz[i] end
cx /= N; cz /= N
for i = 1, N do px[i] -= cx; pz[i] -= cz end

-- elevation: smooth climbs and drops, closed around the loop, under ~7 % grade
local py = {}
for i = 1, N do
	local th = (i - 1) / N * math.pi * 2
	py[i] = 46 + 24 * math.sin(3 * th - math.pi / 2) + 12 * math.sin(7 * th)
end

local tx, tz, rx, rz = {}, {}, {}, {}
for i = 1, N do
	local a, b = (i - 2) % N + 1, i % N + 1
	local dx, dz = px[b] - px[a], pz[b] - pz[a]
	local l = math.sqrt(dx * dx + dz * dz)
	tx[i], tz[i] = dx / l, dz / l
	rx[i], rz[i] = -tz[i], tx[i] -- right-hand side when facing along the road
end

Track.N = N
Track.X, Track.Y, Track.Z = px, py, pz
Track.TX, Track.TZ, Track.RX, Track.RZ = tx, tz, rx, rz
Track.LENGTH = N * Config.SEG

function Track.heading(i: number): number
	return math.atan2(tx[i], tz[i])
end

function Track.slope(i: number): number
	local a, b = (i - 2) % N + 1, i % N + 1
	return (py[b] - py[a]) / (2 * Config.SEG)
end

-- nearest road sample to (x, z), searching around a hint first
function Track.nearest(x: number, z: number, hint: number?): number
	local best, bi = math.huge, 1
	if hint then
		for k = -40, 40 do
			local i = (hint - 1 + k) % N + 1
			local d = (px[i] - x) ^ 2 + (pz[i] - z) ^ 2
			if d < best then best, bi = d, i end
		end
		if best < 40 * 40 then return bi end
	end
	for i = 1, N do
		local d = (px[i] - x) ^ 2 + (pz[i] - z) ^ 2
		if d < best then best, bi = d, i end
	end
	return bi
end

-- sideways offset from the centre line and road height at (x, z) near sample i
function Track.at(x: number, z: number, i: number): (number, number)
	local dx, dz = x - px[i], z - pz[i]
	local along = dx * tx[i] + dz * tz[i]
	return dx * rx[i] + dz * rz[i], py[i] + Track.slope(i) * along
end

return Track
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="9">
      <Properties>
        <string name="Name">KaidoServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Kaido Drift (Roblox) server: builds the night mountain pass, keeps everyone's credits and cars
-- (DataStore), checks drift scores, and relays car positions between players on the public map.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Track = require(Shared.Track)

-- ===================== remotes =====================
local remotes = Instance.new("Folder")
remotes.Name = "KaidoRemotes"
local function remote(class, name)
	local ok, r = pcall(Instance.new, class)
	if not ok then r = Instance.new("RemoteEvent") end
	r.Name = name
	r.Parent = remotes
	return r
end
local GetProfile = remote("RemoteFunction", "GetProfile")
local Buy = remote("RemoteFunction", "Buy")
local SelectCar = remote("RemoteFunction", "Select")
local SetMode = remote("RemoteEvent", "SetMode")
local Bank = remote("RemoteEvent", "Bank")
local State = remote("UnreliableRemoteEvent", "State")
local Others = remote("UnreliableRemoteEvent", "Others")
remotes.Parent = ReplicatedStorage

-- ===================== lighting: midnight with stars =====================
Lighting.ClockTime = 0
Lighting.Brightness = 1.2
Lighting.Ambient = Color3.fromRGB(40, 44, 70)
Lighting.OutdoorAmbient = Color3.fromRGB(55, 60, 95)
Lighting.EnvironmentDiffuseScale = 0.4
Lighting.EnvironmentSpecularScale = 0.6
local atmo = Instance.new("Atmosphere")
atmo.Density, atmo.Offset, atmo.Haze, atmo.Glare = 0.32, 0.1, 1.2, 0
atmo.Color, atmo.Decay = Color3.fromRGB(70, 80, 120), Color3.fromRGB(20, 22, 40)
atmo.Parent = Lighting
local sky = Instance.new("Sky")
sky.StarCount, sky.CelestialBodiesShown, sky.MoonAngularSize = 5000, true, 14
sky.Parent = Lighting
local bloom = Instance.new("BloomEffect")
bloom.Intensity, bloom.Size, bloom.Threshold = 0.6, 28, 1.6
bloom.Parent = Lighting

-- ===================== the map =====================
local map = Instance.new("Folder")
map.Name = "KaidoMap"
map.Parent = workspace
local rng = Random.new(1989)
local N, X, Y, Z = Track.N, Track.X, Track.Y, Track.Z
local HALF = Config.ROAD_HALF

local function block(parent, size, cf, color, material, shape)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	if shape then p.Shape = shape end
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- ground: grass terrain over the whole area
local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
for i = 1, N do
	minX, maxX = math.min(minX, X[i]), math.max(maxX, X[i])
	minZ, maxZ = math.min(minZ, Z[i]), math.max(maxZ, Z[i])
end
local margin = 700
local terrain = workspace.Terrain
for gx = minX - margin, maxX + margin, 2000 do
	for gz = minZ - margin, maxZ + margin, 2000 do
		terrain:FillBlock(CFrame.new(gx + 1000, -4, gz + 1000), Vector3.new(2000, 8, 2000), Enum.Material.Grass)
	end
end

-- lake: the open spot inside the loop furthest from the road
local function inside(x, z)
	local c = false
	local j = N
	for i = 1, N do
		if ((Z[i] > z) ~= (Z[j] > z)) and (x < (X[j] - X[i]) * (z - Z[i]) / (Z[j] - Z[i]) + X[i]) then c = not c end
		j = i
	end
	return c
end
local function roadDist(x, z)
	local best = math.huge
	for i = 1, N, 2 do best = math.min(best, (X[i] - x) ^ 2 + (Z[i] - z) ^ 2) end
	return math.sqrt(best)
end
local lakeX, lakeZ, lakeD = 0, 0, 0
for x = minX, maxX, 120 do
	for z = minZ, maxZ, 120 do
		if inside(x, z) then
			local d = roadDist(x, z)
			if d > lakeD then lakeX, lakeZ, lakeD = x, z, d end
		end
	end
end
local lakeR = math.clamp(lakeD - 90, 0, 650)
if lakeR > 60 then
	terrain:FillCylinder(CFrame.new(lakeX, -1, lakeZ), 4, lakeR, Enum.Material.Water)
end

-- road, rails, centre line, embankment
local road = Instance.new("Folder")
road.Name = "Road"
road.Parent = map
local asphalt, rail, rock = Color3.fromRGB(46, 47, 52), Color3.fromRGB(170, 172, 176), Color3.fromRGB(92, 84, 74)
for i = 1, N do
	local j = i % N + 1
	local a, b = Vector3.new(X[i], Y[i], Z[i]), Vector3.new(X[j], Y[j], Z[j])
	local mid = (a + b) / 2
	local turn = math.abs(math.atan2(Track.TX[i] * Track.TZ[j] - Track.TZ[i] * Track.TX[j], Track.TX[i] * Track.TX[j] + Track.TZ[i] * Track.TZ[j]))
	local len = (b - a).Magnitude + 1 + HALF * 2 * turn
	local cf = CFrame.lookAt(mid, b)
	local seg = block(road, Vector3.new(HALF * 2, 1, len), cf * CFrame.new(0, -0.5, 0), asphalt, Enum.Material.Asphalt)
	seg.Name = "Road"
	for _, side in { -1, 1 } do
		local r = block(road, Vector3.new(0.6, 2.4, len), cf * CFrame.new(side * (HALF + 0.9), 1.0, 0), rail, Enum.Material.DiamondPlate)
		r.Name = "Rail"
		local kerb = block(road, Vector3.new(1.2, 0.2, len), cf * CFrame.new(side * (HALF - 0.6), 0.05, 0), (i // 2) % 2 == 0 and Color3.fromRGB(210, 40, 40) or Color3.fromRGB(235, 235, 235), Enum.Material.SmoothPlastic)
		kerb.CanCollide = false
	end
	if i % 3 == 0 then
		local line = block(road, Vector3.new(0.5, 0.1, Config.SEG * 1.4), cf * CFrame.new(0, 0.02, 0), Color3.fromRGB(240, 236, 220), Enum.Material.SmoothPlastic)
		line.CanCollide = false
	end
	if i % 2 == 0 and mid.Y > 2 then
		local flat = CFrame.lookAt(Vector3.new(mid.X, mid.Y / 2 - 1, mid.Z), Vector3.new(b.X, mid.Y / 2 - 1, b.Z))
		block(road, Vector3.new(HALF * 2 + 8, mid.Y, len * 2 + 2), flat, rock, Enum.Material.Slate)
	end
end

-- street lamps
local lamps = Instance.new("Folder")
lamps.Name = "Lamps"
lamps.Parent = map
for i = 1, N, 14 do
	local side = (i // 14) % 2 == 0 and 1 or -1
	local base = Vector3.new(X[i] + Track.RX[i] * side * (HALF + 3), Y[i], Z[i] + Track.RZ[i] * side * (HALF + 3))
	local inward = Vector3.new(-Track.RX[i] * side, 0, -Track.RZ[i] * side)
	block(lamps, Vector3.new(0.8, 18, 0.8), CFrame.new(base + Vector3.new(0, 9, 0)), Color3.fromRGB(60, 62, 66), Enum.Material.Metal)
	block(lamps, Vector3.new(0.5, 0.5, 6), CFrame.lookAt(base + Vector3.new(0, 18, 0) + inward * 3, base + Vector3.new(0, 18, 0) + inward * 6), Color3.fromRGB(60, 62, 66), Enum.Material.Metal)
	local head = block(lamps, Vector3.new(2.2, 0.5, 1.2), CFrame.new(base + Vector3.new(0, 17.6, 0) + inward * 5.5), Color3.fromRGB(255, 196, 120), Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness, light.Shadows = Color3.fromRGB(255, 190, 120), 42, 2.2, false
	light.Parent = head
end

-- cedar and maple trees on the hillsides
local trees = Instance.new("Folder")
trees.Name = "Trees"
trees.Parent = map
local placed = 0
for _ = 1, 4000 do
	if placed >= 900 then break end
	local i = rng:NextInteger(1, N)
	local off = (HALF + 14 + rng:NextNumber() ^ 1.4 * 320) * (rng:NextNumber() < 0.5 and -1 or 1)
	local x, z = X[i] + Track.RX[i] * off, Z[i] + Track.RZ[i] * off
	if roadDist(x, z) > HALF + 12 and (lakeR <= 60 or (x - lakeX) ^ 2 + (z - lakeZ) ^ 2 > (lakeR + 20) ^ 2) then
		local s = 0.8 + rng:NextNumber() * 0.9
		local ground = Vector3.new(x, 0, z)
		block(trees, Vector3.new(14 * s, 1.6 * s, 1.6 * s), CFrame.new(ground + Vector3.new(0, 7 * s, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(70, 50, 38), Enum.Material.Wood, Enum.PartType.Cylinder)
		local maple = rng:NextNumber() < 0.25
		local leaf = maple and (rng:NextNumber() < 0.5 and Color3.fromRGB(176, 52, 30) or Color3.fromRGB(214, 140, 40)) or Color3.fromRGB(28 + rng:NextInteger(0, 16), 66 + rng:NextInteger(0, 20), 38)
		for k = 0, 2 do
			local r = (9 - k * 2.4) * s
			block(trees, Vector3.new(r * 2, r * 1.5, r * 2), CFrame.new(ground + Vector3.new(0, (12 + k * 6) * s, 0)), leaf, Enum.Material.Grass, Enum.PartType.Ball)
		end
		placed += 1
	end
end

-- Kojiri village by the start: wooden houses with lantern-lit doors, on platforms at road height
local village = Instance.new("Folder")
village.Name = "Village"
village.Parent = map
local wood, roofC = Color3.fromRGB(96, 66, 46), Color3.fromRGB(40, 42, 48)
for n = 0, 9 do
	local i = (n * 6) % N + 1
	local side = n % 2 == 0 and 1 or -1
	local dist = HALF + 26 + (n % 3) * 6
	local c = Vector3.new(X[i] + Track.RX[i] * side * dist, Y[i], Z[i] + Track.RZ[i] * side * dist)
	local face = CFrame.lookAt(c, c - Vector3.new(Track.RX[i] * side, 0, Track.RZ[i] * side))
	block(village, Vector3.new(30, Y[i] + 2, 30), CFrame.new(c - Vector3.new(0, (Y[i] + 2) / 2, 0)), Color3.fromRGB(80, 74, 66), Enum.Material.Cobblestone)
	block(village, Vector3.new(22, 12, 16), face * CFrame.new(0, 6, 0), wood, Enum.Material.WoodPlanks)
	local r1 = Instance.new("WedgePart")
	r1.Anchored, r1.Size, r1.Color, r1.Material = true, Vector3.new(24, 5, 9), roofC, Enum.Material.Slate
	r1.CFrame = face * CFrame.new(0, 14.5, -4.5) -- tall edge toward the ridge
	r1.Parent = village
	local r2 = r1:Clone()
	r2.CFrame = face * CFrame.new(0, 14.5, 4.5) * CFrame.Angles(0, math.pi, 0)
	r2.Parent = village
	for w = -1, 1, 2 do
		block(village, Vector3.new(3, 3, 0.3), face * CFrame.new(w * 6, 7, -8.05), Color3.fromRGB(255, 200, 120), Enum.Material.Neon)
	end
	local lantern = block(village, Vector3.new(1.6, 2.2, 1.6), face * CFrame.new(0, 9, -9), Color3.fromRGB(240, 60, 40), Enum.Material.Neon, Enum.PartType.Ball)
	local pl = Instance.new("PointLight")
	pl.Color, pl.Range, pl.Brightness = Color3.fromRGB(255, 140, 90), 22, 2
	pl.Parent = lantern
end

-- the start gate
do
	local i = 1
	local c = Vector3.new(X[i], Y[i], Z[i])
	local face = CFrame.lookAt(c, c + Vector3.new(Track.TX[i], 0, Track.TZ[i]))
	local red = Color3.fromRGB(196, 30, 34)
	for _, s in { -1, 1 } do block(map, Vector3.new(1.6, 22, 1.6), face * CFrame.new(s * (HALF + 3), 11, 0), red, Enum.Material.Wood) end
	block(map, Vector3.new(HALF * 2 + 14, 1.6, 2.4), face * CFrame.new(0, 21, 0), red, Enum.Material.Wood)
	block(map, Vector3.new(HALF * 2 + 10, 1.2, 1.8), face * CFrame.new(0, 18.5, 0), Color3.fromRGB(30, 30, 30), Enum.Material.Wood)
end

map:SetAttribute("Ready", true)

-- ===================== player data =====================
local store
pcall(function() store = DataStoreService:GetDataStore("KaidoDrift_v1") end)
local profiles, lastBank, publicMode = {}, {}, {}

local function defaultProfile()
	return { credits = 0, owned = { ps13 = true }, selected = "ps13", best = 0 }
end

local function stats(player, p)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		local c = Instance.new("IntValue")
		c.Name = "Credits"
		c.Parent = ls
		local b = Instance.new("IntValue")
		b.Name = "Best drift"
		b.Parent = ls
		ls.Parent = player
	end
	ls.Credits.Value = p.credits
	ls["Best drift"].Value = p.best
end

local function load(player)
	local p = defaultProfile()
	if store then
		local ok, data = pcall(function() return store:GetAsync("p_" .. player.UserId) end)
		if ok and type(data) == "table" then
			p.credits = tonumber(data.credits) or 0
			p.best = tonumber(data.best) or 0
			if type(data.owned) == "table" then
				for id, v in data.owned do
					if v and Config.car(id).id == id then p.owned[id] = true end
				end
			end
			if type(data.selected) == "string" and p.owned[data.selected] then p.selected = data.selected end
		end
	end
	profiles[player] = p
	stats(player, p)
end

local function save(player)
	local p = profiles[player]
	if p and store then
		pcall(function() store:SetAsync("p_" .. player.UserId, p) end)
	end
end

local function view(p)
	local owned = {}
	for id in p.owned do table.insert(owned, id) end
	return { credits = p.credits, owned = owned, selected = p.selected, best = p.best }
end

Players.PlayerAdded:Connect(load)
for _, pl in Players:GetPlayers() do task.spawn(load, pl) end
Players.PlayerRemoving:Connect(function(player)
	save(player)
	profiles[player], lastBank[player], publicMode[player] = nil, nil, nil
end)
game:BindToClose(function()
	for _, pl in Players:GetPlayers() do save(pl) end
end)
task.spawn(function()
	while true do
		task.wait(90)
		for _, pl in Players:GetPlayers() do save(pl) end
	end
end)

GetProfile.OnServerInvoke = function(player)
	while not profiles[player] do task.wait(0.1) end
	return view(profiles[player])
end

Buy.OnServerInvoke = function(player, id)
	local p = profiles[player]
	if not p or type(id) ~= "string" then return nil end
	local car = Config.car(id)
	if car.id == id and not p.owned[id] and p.credits >= car.price then
		p.credits -= car.price
		p.owned[id] = true
		p.selected = id
		stats(player, p)
		task.spawn(save, player)
	end
	return view(p)
end

SelectCar.OnServerInvoke = function(player, id)
	local p = profiles[player]
	if p and type(id) == "string" and p.owned[id] then p.selected = id end
	return p and view(p)
end

-- a finished drift: capped, and no faster than a real drift could earn
Bank.OnServerEvent:Connect(function(player, points)
	local p = profiles[player]
	if not p or type(points) ~= "number" or points ~= points or points <= 0 then return end
	local now = os.clock()
	local since = now - (lastBank[player] or 0)
	lastBank[player] = now
	points = math.floor(math.min(points, 60000, since * 4000))
	if points <= 0 then return end
	p.credits += points
	p.best = math.max(p.best, points)
	stats(player, p)
end)

-- solo players are hidden from the public map and see no one
SetMode.OnServerEvent:Connect(function(player, mode)
	publicMode[player] = mode == "public"
end)

State.OnServerEvent:Connect(function(player, x, y, z, h, carId, drifting)
	if not publicMode[player] then return end
	if type(x) ~= "number" or type(y) ~= "number" or type(z) ~= "number" or type(h) ~= "number" or type(carId) ~= "string" then return end
	if x ~= x or y ~= y or z ~= z or h ~= h then return end
	for _, other in Players:GetPlayers() do
		if other ~= player and publicMode[other] then
			Others:FireClient(other, player.UserId, x, y, z, h, carId, drifting == true)
		end
	end
end)
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="10">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="11">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="12">
        <Properties>
          <string name="Name">KaidoClient</string>
          <string name="Source"><![CDATA[-- Kaido Drift (Roblox) client: menus, garage, HUD, controls (keyboard, controller, touch),
-- the drift car, scoring and the camera.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Track = require(Shared:WaitForChild("Track"))
local CarPhysics = require(Shared:WaitForChild("CarPhysics"))
local CarModel = require(Shared:WaitForChild("CarModel"))
local R = ReplicatedStorage:WaitForChild("KaidoRemotes")

pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false) end)

local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
local camera = workspace.CurrentCamera
camera.CameraType = Enum.CameraType.Scriptable

-- ===================== UI helpers =====================
local PINK, CYAN, GOLD = Color3.fromRGB(255, 126, 182), Color3.fromRGB(89, 227, 255), Color3.fromRGB(255, 201, 77)
local INK, PANEL = Color3.fromRGB(12, 13, 22), Color3.fromRGB(16, 18, 30)

local function make(class, props, children)
	local o = Instance.new(class)
	for k, v in props do
		if k ~= "Parent" then (o :: any)[k] = v end
	end
	for _, c in children or {} do c.Parent = o end
	if props.Parent then o.Parent = props.Parent end
	return o
end
local function corner(r) return make("UICorner", { CornerRadius = UDim.new(0, r or 6) }) end
local function stroke(c, t) return make("UIStroke", { Color = c, Thickness = t or 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }) end
local function label(props)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.TextColor3 = props.TextColor3 or Color3.new(1, 1, 1)
	props.Font = props.Font or Enum.Font.GothamBold
	props.TextScaled = props.TextScaled ~= false
	return make("TextLabel", props)
end
local function button(text, sub, color, parent, order)
	local b = make("TextButton", {
		Size = UDim2.new(1, 0, 0, sub and 62 or 48), BackgroundColor3 = color or PANEL, AutoButtonColor = true,
		Text = "", LayoutOrder = order or 0, Parent = parent,
	}, { corner(6), stroke(color == PANEL and Color3.fromRGB(70, 74, 100) or color, 1.5) })
	label({ Text = text, Size = UDim2.new(1, -24, 0, 24), Position = UDim2.new(0, 12, 0, sub and 9 or 12), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBlack, TextColor3 = (color == PINK) and INK or Color3.new(1, 1, 1), Parent = b })
	if sub then
		label({ Text = sub, Size = UDim2.new(1, -24, 0, 16), Position = UDim2.new(0, 12, 0, 37), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.Gotham, TextColor3 = (color == PINK) and INK or Color3.fromRGB(190, 194, 214), Parent = b })
	end
	return b
end

local gui = make("ScreenGui", { Name = "KaidoUI", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = player:WaitForChild("PlayerGui") })

local loading = label({ Text = "Building the mountain pass…", Size = UDim2.new(0, 360, 0, 28), Position = UDim2.new(0.5, -180, 0.5, -14), Parent = gui })
local mapFolder = workspace:WaitForChild("KaidoMap")
while not mapFolder:GetAttribute("Ready") do task.wait(0.2) end

local profile = R.GetProfile:InvokeServer()
loading:Destroy()

-- ===================== state =====================
local mode = "menu" -- menu | garage | play
local publicMap = false
local easy = true
local camMode = 0 -- 0 chase, 1 far chase, 2 cockpit
local carDef = Config.car(profile.selected)
local carPhys = Config.physics(carDef)
local startH = Track.heading(1)
local S = CarPhysics.new(Track.X[1], Track.Z[1], startH)
local idx, posY = 1, Track.Y[1]
local carModel: Model? = nil
local input = { thr = 0, brk = 0, hand = false, steer = 0 }
local drift = { active = false, score = 0, mult = 1, t = 0, off = 0 }
local wallT = 0

local function owned(id)
	for _, o in profile.owned do if o == id then return true end end
	return false
end

local function spawnCar()
	if carModel then carModel:Destroy() end
	carDef = Config.car(profile.selected)
	carPhys = Config.physics(carDef)
	carModel = CarModel.build(carDef, "MyCar")
	carModel.Parent = workspace
	-- tyre smoke
	for _, a in carModel.PrimaryPart:GetChildren() do
		if a:IsA("Attachment") then
			make("ParticleEmitter", {
				Name = "Smoke", Texture = "rbxasset://textures/particles/smoke_main.dds", Rate = 0, Enabled = true,
				Lifetime = NumberRange.new(1.4, 2.4), Speed = NumberRange.new(2, 6), SpreadAngle = Vector2.new(40, 40),
				Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 12) }),
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) }),
				Color = ColorSequence.new(Color3.fromRGB(220, 222, 230)), Drag = 1.5, Acceleration = Vector3.new(0, 3, 0),
				LightInfluence = 1, Parent = a,
			})
		end
	end
end

local function resetCar(i)
	i = i or Track.nearest(S.x, S.z, idx)
	local h = Track.heading(i)
	S = CarPhysics.new(Track.X[i], Track.Z[i], h)
	idx, posY = i, Track.Y[i]
	drift.active, drift.score, drift.mult = false, 0, 1
end

-- ===================== title screen =====================
local title = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = INK, BackgroundTransparency = 0.35, Parent = gui })
local tCol = make("Frame", { Size = UDim2.new(0, 380, 1, 0), Position = UDim2.new(0, 40, 0, 0), BackgroundTransparency = 1, Parent = title }, {
	make("UIListLayout", { Padding = UDim.new(0, 10), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
	make("UISizeConstraint", { MaxSize = Vector2.new(380, math.huge) }),
})
if touch then tCol.Size = UDim2.new(0.86, 0, 1, 0); tCol.Position = UDim2.new(0.07, 0, 0, 0) end
label({ Text = "KAIDO DRIFT", Size = UDim2.new(1, 0, 0, 54), Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1, Parent = tCol })
label({ Text = "街道 · 峠  —  midnight on the mountain pass", Size = UDim2.new(1, 0, 0, 20), TextColor3 = PINK, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 2, Parent = tCol })
local tStats = label({ Text = "", Size = UDim2.new(1, 0, 0, 18), Font = Enum.Font.Gotham, TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 3, Parent = tCol })
local bSolo = button("PLAY SOLO", "Just you on the mountain", PINK, tCol, 4)
local bPublic = button("PLAY WITH OTHERS", "Public map · drift with everyone in this server + chat", PANEL, tCol, 5)
bPublic:FindFirstChildOfClass("UIStroke").Color = CYAN
local bGarage = button("GARAGE", "Unlock and choose cars", PANEL, tCol, 6)
local bEasy = button("EASY DRIFT: ON", "Steer hard with gas to slide · no hand brake needed", PANEL, tCol, 7)
label({
	Text = touch and "Drag on the left to steer · GAS, BRAKE, HAND on the right" or "W/S gas & brake · A/D steer · Space hand brake · C camera · R reset · controllers work too",
	Size = UDim2.new(1, 0, 0, 30), Font = Enum.Font.Gotham, TextColor3 = Color3.fromRGB(170, 174, 196), TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, LayoutOrder = 8, Parent = tCol,
})

local function fmt(n)
	local s = tostring(math.floor(n)):reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (s:gsub("^,", ""))
end
local function refreshTitle()
	tStats.Text = string.format("%s CR   ·   best drift %s   ·   %s", fmt(profile.credits), fmt(profile.best), Config.car(profile.selected).name)
end
refreshTitle()

-- ===================== garage =====================
local garage = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = INK, BackgroundTransparency = 0.2, Visible = false, Parent = gui })
local gBox = make("Frame", { Size = UDim2.new(0.9, 0, 0.86, 0), Position = UDim2.new(0.05, 0, 0.07, 0), BackgroundTransparency = 1, Parent = garage }, {
	make("UISizeConstraint", { MaxSize = Vector2.new(560, math.huge) }),
})
label({ Text = "GARAGE", Size = UDim2.new(1, 0, 0, 40), Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Left, Parent = gBox })
local gCredits = label({ Text = "", Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 0, 42), TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Left, Parent = gBox })
local gList = make("ScrollingFrame", { Size = UDim2.new(1, 0, 1, -130), Position = UDim2.new(0, 0, 0, 70), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = gBox }, {
	make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
})
local gBack = button("BACK", nil, PANEL, gBox, 0)
gBack.Position = UDim2.new(0, 0, 1, -50)

local function bar(v)
	local n = math.clamp(math.floor(v * 10 + 0.5), 1, 10)
	return string.rep("■", n) .. string.rep("□", 10 - n)
end
local function renderGarage()
	gCredits.Text = fmt(profile.credits) .. " CR"
	for _, c in gList:GetChildren() do if c:IsA("Frame") then c:Destroy() end end
	for k, car in Config.Cars do
		local row = make("Frame", { Size = UDim2.new(1, -8, 0, 92), BackgroundColor3 = PANEL, LayoutOrder = k, Parent = gList }, { corner(6), stroke(car.id == profile.selected and PINK or Color3.fromRGB(60, 64, 90), 1.5) })
		make("Frame", { Size = UDim2.new(0, 10, 1, -16), Position = UDim2.new(0, 8, 0, 8), BackgroundColor3 = car.color, Parent = row }, { corner(3) })
		label({ Text = car.name, Size = UDim2.new(0.6, 0, 0, 22), Position = UDim2.new(0, 28, 0, 8), Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
		label({ Text = "POWER " .. bar(car.power / 1650) .. "\nGRIP  " .. bar((car.grip - 0.9) / 0.2) .. "\nTOP   " .. car.top .. " km/h", Size = UDim2.new(0.6, 0, 0, 48), Position = UDim2.new(0, 28, 0, 34), Font = Enum.Font.Code, TextColor3 = Color3.fromRGB(190, 194, 214), TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
		local have = owned(car.id)
		local txt = car.id == profile.selected and "SELECTED" or have and "SELECT" or (fmt(car.price) .. " CR")
		local can = have or profile.credits >= car.price
		local b = make("TextButton", { Size = UDim2.new(0.32, 0, 0, 40), Position = UDim2.new(0.66, 0, 0.5, -20), BackgroundColor3 = (have or can) and PINK or Color3.fromRGB(50, 52, 66), AutoButtonColor = true, Text = txt, TextScaled = true, Font = Enum.Font.GothamBlack, TextColor3 = INK, Parent = row }, { corner(6), make("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }) })
		b.Activated:Connect(function()
			if car.id == profile.selected then return end
			local res = have and R.Select:InvokeServer(car.id) or (can and R.Buy:InvokeServer(car.id))
			if res then profile = res; spawnCar(); resetCar(1); renderGarage(); refreshTitle() end
		end)
	end
end

-- ===================== HUD =====================
local hud = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = gui })
local hCredits = label({ Text = "", Size = UDim2.new(0, 220, 0, 24), Position = UDim2.new(0, 16, 0, 14), TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Left, Parent = hud })
local hMode = label({ Text = "", Size = UDim2.new(0, 260, 0, 16), Position = UDim2.new(0, 16, 0, 40), Font = Enum.Font.Gotham, TextColor3 = Color3.fromRGB(190, 194, 214), TextXAlignment = Enum.TextXAlignment.Left, Parent = hud })
-- drift score: compact, top centre (small on phones so it never covers the road)
local dW = touch and 150 or 260
local dBox = make("Frame", { Size = UDim2.new(0, dW, 0, touch and 64 or 96), Position = UDim2.new(0.5, -dW / 2, 0, touch and 8 or 14), BackgroundTransparency = 1, Visible = false, Parent = hud })
local dTier = label({ Text = "DRIFT", Size = UDim2.new(0.6, 0, 0.22, 0), TextColor3 = GOLD, Parent = dBox })
local dMult = label({ Text = "×1.0", Size = UDim2.new(0.4, 0, 0.22, 0), Position = UDim2.new(0.6, 0, 0, 0), TextColor3 = PINK, Parent = dBox })
local dScore = label({ Text = "0", Size = UDim2.new(1, 0, 0.6, 0), Position = UDim2.new(0, 0, 0.26, 0), Font = Enum.Font.GothamBlack, Parent = dBox }, nil)
make("UIStroke", { Color = INK, Thickness = 2, Parent = dScore })
local toast = label({ Text = "", Size = UDim2.new(0, 360, 0, 26), Position = UDim2.new(0.5, -180, 0, touch and 76 or 116), TextColor3 = GOLD, TextTransparency = 1, Parent = hud })
local toastT = 0
local function showToast(t, c)
	toast.Text, toast.TextColor3, toast.TextTransparency, toastT = t, c or GOLD, 0, 2
end
-- speed
local sp = make("Frame", { Size = UDim2.new(0, 170, 0, 74), Position = touch and UDim2.new(0, 16, 1, -250) or UDim2.new(0.5, -85, 1, -92), BackgroundTransparency = 1, Parent = hud })
local hSpeed = label({ Text = "0", Size = UDim2.new(0.62, 0, 0.7, 0), Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Right, Parent = sp })
label({ Text = "KM/H", Size = UDim2.new(0.34, 0, 0.26, 0), Position = UDim2.new(0.66, 0, 0.08, 0), Font = Enum.Font.Gotham, TextColor3 = Color3.fromRGB(190, 194, 214), TextXAlignment = Enum.TextXAlignment.Left, Parent = sp })
local hGear = label({ Text = "1", Size = UDim2.new(0.34, 0, 0.36, 0), Position = UDim2.new(0.66, 0, 0.36, 0), TextColor3 = CYAN, TextXAlignment = Enum.TextXAlignment.Left, Parent = sp })
local rpmBack = make("Frame", { Size = UDim2.new(1, 0, 0, 5), Position = UDim2.new(0, 0, 1, -5), BackgroundColor3 = Color3.fromRGB(40, 42, 60), BorderSizePixel = 0, Parent = sp })
local rpmBar = make("Frame", { Size = UDim2.new(0.2, 0, 1, 0), BackgroundColor3 = PINK, BorderSizePixel = 0, Parent = rpmBack })
-- minimap
local mmSize = touch and 96 or 140
local mm = make("Frame", { Size = UDim2.new(0, mmSize, 0, mmSize), Position = UDim2.new(1, -mmSize - 14, 0, 14), BackgroundColor3 = INK, BackgroundTransparency = 0.35, Parent = hud }, { corner(mmSize), stroke(Color3.fromRGB(70, 74, 100), 1) })
local mmMinX, mmMaxX, mmMinZ, mmMaxZ = math.huge, -math.huge, math.huge, -math.huge
for i = 1, Track.N do
	mmMinX, mmMaxX = math.min(mmMinX, Track.X[i]), math.max(mmMaxX, Track.X[i])
	mmMinZ, mmMaxZ = math.min(mmMinZ, Track.Z[i]), math.max(mmMaxZ, Track.Z[i])
end
local mmSpan = math.max(mmMaxX - mmMinX, mmMaxZ - mmMinZ) * 1.15
local function mmPos(x, z)
	return UDim2.new(0.5 + (x - (mmMinX + mmMaxX) / 2) / mmSpan, 0, 0.5 + (z - (mmMinZ + mmMaxZ) / 2) / mmSpan, 0)
end
for i = 1, Track.N, math.max(1, Track.N // 140) do
	make("Frame", { Size = UDim2.new(0, 3, 0, 3), AnchorPoint = Vector2.new(0.5, 0.5), Position = mmPos(Track.X[i], Track.Z[i]), BackgroundColor3 = Color3.fromRGB(235, 230, 220), BorderSizePixel = 0, Parent = mm })
end
local mmMe = make("Frame", { Size = UDim2.new(0, 9, 0, 9), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = PINK, BorderSizePixel = 0, ZIndex = 3, Parent = mm }, { corner(9) })
-- buttons under the minimap
local hb = make("Frame", { Size = UDim2.new(0, 3 * 62, 0, 40), Position = UDim2.new(1, -3 * 62 - 14, 0, mmSize + 22), BackgroundTransparency = 1, Parent = hud }, {
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Right }),
})
local function smallBtn(t)
	return make("TextButton", { Size = UDim2.new(0, 56, 0, 40), BackgroundColor3 = PANEL, BackgroundTransparency = 0.2, Text = t, TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 14, Parent = hb }, { corner(6), stroke(Color3.fromRGB(70, 74, 100), 1) })
end
local bCam, bReset, bMenu = smallBtn("CAM"), smallBtn("↺"), smallBtn("MENU")

-- ===================== touch controls =====================
local touchState = { gas = false, brake = false, hand = false, steer = 0 }
if touch then
	local steerZone = make("Frame", { Size = UDim2.new(0.5, 0, 0.62, 0), Position = UDim2.new(0, 0, 0.38, 0), BackgroundTransparency = 1, Parent = hud })
	local knobBase = make("Frame", { Size = UDim2.new(0, 160, 0, 52), Position = UDim2.new(0, 24, 1, -80), BackgroundColor3 = PANEL, BackgroundTransparency = 0.4, Parent = hud }, { corner(26), stroke(Color3.fromRGB(70, 74, 100), 1) })
	local knob = make("Frame", { Size = UDim2.new(0, 44, 0, 44), Position = UDim2.new(0.5, -22, 0, 4), BackgroundColor3 = CYAN, BackgroundTransparency = 0.2, Parent = knobBase }, { corner(22) })
	local steerInput, startX = nil, 0
	steerZone.InputBegan:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.Touch and not steerInput then steerInput, startX = io, io.Position.X end
	end)
	UserInputService.InputChanged:Connect(function(io)
		if io == steerInput then touchState.steer = math.clamp((io.Position.X - startX) / 70, -1, 1) end
	end)
	UserInputService.InputEnded:Connect(function(io)
		if io == steerInput then steerInput = nil; touchState.steer = 0 end
	end)
	RunService.RenderStepped:Connect(function()
		knob.Position = UDim2.new(0.5, -22 + touchState.steer * 54, 0, 4)
	end)
	local function pedal(text, size, pos, color, key)
		local b = make("TextButton", { Size = size, Position = pos, BackgroundColor3 = color, BackgroundTransparency = 0.25, Text = text, TextColor3 = INK, Font = Enum.Font.GothamBlack, TextSize = 16, Parent = hud }, { corner(10) })
		local held = {}
		b.InputBegan:Connect(function(io)
			if io.UserInputType == Enum.UserInputType.Touch then held[io] = true; touchState[key] = true end
		end)
		b.InputEnded:Connect(function(io)
			held[io] = nil
			if next(held) == nil then touchState[key] = false end
		end)
	end
	pedal("GAS", UDim2.new(0, 88, 0, 150), UDim2.new(1, -104, 1, -166), PINK, "gas")
	pedal("BRAKE", UDim2.new(0, 80, 0, 70), UDim2.new(1, -196, 1, -86), Color3.fromRGB(200, 204, 220), "brake")
	pedal("HAND", UDim2.new(0, 80, 0, 70), UDim2.new(1, -196, 1, -166), CYAN, "hand")
end

-- ===================== other players (public map) =====================
local ghosts = {}
R.Others.OnClientEvent:Connect(function(uid, x, y, z, h, carId, drifting)
	if not publicMap or mode ~= "play" then return end
	local g = ghosts[uid]
	if not g or g.carId ~= carId then
		if g then g.model:Destroy() end
		local m = CarModel.build(Config.car(carId), "Ghost" .. uid)
		local who = Players:GetPlayerByUserId(uid)
		local tag = make("BillboardGui", { Size = UDim2.new(0, 140, 0, 26), StudsOffset = Vector3.new(0, 8, 0), AlwaysOnTop = true, MaxDistance = 400, Parent = m.PrimaryPart })
		label({ Text = who and who.DisplayName or "Driver", Size = UDim2.fromScale(1, 1), TextColor3 = CYAN, Parent = tag })
		m.Parent = workspace
		g = { model = m, carId = carId, cf = CFrame.new(x, y, z) * CFrame.Angles(0, h + math.pi, 0) }
		ghosts[uid] = g
	end
	g.target = CFrame.new(x, y, z) * CFrame.Angles(0, h + math.pi, 0) -- car forward is (sin h, cos h)
	g.seen = os.clock()
end)
local function clearGhosts()
	for uid, g in ghosts do g.model:Destroy(); ghosts[uid] = nil end
end
Players.PlayerRemoving:Connect(function(p)
	local g = ghosts[p.UserId]
	if g then g.model:Destroy(); ghosts[p.UserId] = nil end
end)

-- ===================== screens =====================
local function setMode(m)
	mode = m
	title.Visible = m == "menu"
	garage.Visible = m == "garage"
	hud.Visible = m == "play"
	if m ~= "play" then clearGhosts() end
	if m == "garage" then renderGarage() end
	if m == "menu" then refreshTitle() end
end
local function start(public)
	publicMap = public
	R.SetMode:FireServer(public and "public" or "solo")
	hMode.Text = public and "PUBLIC MAP · everyone in this server" or "SOLO · just you"
	setMode("play")
	if public then showToast("Public map · say hi in chat!", CYAN) end
end
bSolo.Activated:Connect(function() start(false) end)
bPublic.Activated:Connect(function() start(true) end)
bGarage.Activated:Connect(function() setMode("garage") end)
gBack.Activated:Connect(function() setMode("menu") end)
bEasy.Activated:Connect(function()
	easy = not easy
	bEasy:FindFirstChildWhichIsA("TextLabel").Text = easy and "EASY DRIFT: ON" or "EASY DRIFT: OFF (sim)"
end)
bMenu.Activated:Connect(function()
	R.SetMode:FireServer("solo")
	setMode("menu")
end)
local function cycleCam()
	camMode = (camMode + 1) % 3
	showToast(({ "Chase camera", "Far chase", "Cockpit · first person" })[camMode + 1], Color3.new(1, 1, 1))
end
bCam.Activated:Connect(cycleCam)
bReset.Activated:Connect(function() resetCar() end)
UserInputService.InputBegan:Connect(function(io, processed)
	if processed or mode ~= "play" then return end
	if io.KeyCode == Enum.KeyCode.C or io.KeyCode == Enum.KeyCode.V or io.KeyCode == Enum.KeyCode.ButtonY then cycleCam() end
	if io.KeyCode == Enum.KeyCode.R or io.KeyCode == Enum.KeyCode.ButtonSelect then resetCar() end
end)

-- ===================== input =====================
local function readInput(dt)
	local thr, brk, hand, steer = 0, 0, false, 0
	if not UserInputService:GetFocusedTextBox() then
		local k = UserInputService
		if k:IsKeyDown(Enum.KeyCode.W) or k:IsKeyDown(Enum.KeyCode.Up) then thr = 1 end
		if k:IsKeyDown(Enum.KeyCode.S) or k:IsKeyDown(Enum.KeyCode.Down) then brk = 1 end
		if k:IsKeyDown(Enum.KeyCode.A) or k:IsKeyDown(Enum.KeyCode.Left) then steer -= 1 end
		if k:IsKeyDown(Enum.KeyCode.D) or k:IsKeyDown(Enum.KeyCode.Right) then steer += 1 end
		hand = k:IsKeyDown(Enum.KeyCode.Space)
	end
	local okPad, pad = pcall(UserInputService.GetGamepadState, UserInputService, Enum.UserInputType.Gamepad1)
	for _, io in (okPad and pad or {}) do
		if io.KeyCode == Enum.KeyCode.Thumbstick1 and math.abs(io.Position.X) > 0.12 then steer = io.Position.X end
		if io.KeyCode == Enum.KeyCode.ButtonR2 then thr = math.max(thr, io.Position.Z) end
		if io.KeyCode == Enum.KeyCode.ButtonL2 then brk = math.max(brk, io.Position.Z) end
		if (io.KeyCode == Enum.KeyCode.ButtonX or io.KeyCode == Enum.KeyCode.ButtonA) and io.UserInputState == Enum.UserInputState.Begin then hand = true end
	end
	if touch then
		if touchState.gas then thr = 1 end
		if touchState.brake then brk = 1 end
		if touchState.hand then hand = true end
		if touchState.steer ~= 0 then steer = touchState.steer end
	end
	-- keys and buttons are on/off: ramp the steering so it feels smooth
	input.steer += math.clamp(steer - input.steer, -dt * 5, dt * 5)
	input.thr, input.brk, input.hand = thr, brk, hand
end

-- ===================== drift scoring =====================
local TIERS = { { 0, "DRIFT" }, { 1500, "NICE" }, { 5000, "GREAT" }, { 12000, "KAIDO" }, { 25000, "LEGEND" } }
local function endDrift(keep)
	if drift.active and drift.score > 0 then
		local pts = math.floor(drift.score * drift.mult)
		if keep and pts >= 50 then
			R.Bank:FireServer(pts)
			profile.credits += pts
			profile.best = math.max(profile.best, pts)
			showToast("+" .. fmt(pts) .. " CR", GOLD)
		elseif not keep then
			showToast("Crashed · drift lost", Color3.fromRGB(255, 90, 90))
		end
	end
	drift.active, drift.score, drift.mult, drift.t, drift.off = false, 0, 1, 0, 0
end
local function updateDrift(dt)
	local kmh = CarPhysics.kmh(S.speed)
	local ang = math.abs(S.beta) * 57.3
	if ang > 10 and kmh > 25 and ang < 110 then
		drift.active = true
		drift.off = 0
		drift.t += dt
		drift.score += ang * kmh * 0.03 * dt * 10
		drift.mult = math.min(5, 1 + drift.t * 0.2)
	elseif drift.active then
		drift.off += dt
		if drift.off > 0.7 then endDrift(true) end
	end
end

-- ===================== main loop =====================
local camPos = camera.CFrame.Position
local sendT, orbit, smokeOn = 0, 0, false
RunService.RenderStepped:Connect(function(dt)
	dt = math.min(dt, 0.05)
	if not carModel then spawnCar() end
	local m = carModel :: Model

	if mode == "play" then
		readInput(dt)
		local steps = math.max(1, math.ceil(dt * 120))
		for _ = 1, steps do CarPhysics.step(S, input, carPhys, easy, dt / steps) end
		-- stay on the road: guardrails
		idx = Track.nearest(S.x, S.z, idx)
		local lat, y = Track.at(S.x, S.z, idx)
		local lim = Config.ROAD_HALF - 3.4
		if math.abs(lat) > lim then
			local rx, rz = Track.RX[idx], Track.RZ[idx]
			local sgn = lat > 0 and 1 or -1
			S.x -= rx * (math.abs(lat) - lim) * sgn
			S.z -= rz * (math.abs(lat) - lim) * sgn
			local vn = S.vx * rx + S.vz * rz
			if vn * sgn > 0 then
				S.vx -= rx * vn * 1.35; S.vz -= rz * vn * 1.35
				S.vx *= 0.9; S.vz *= 0.9
				S.r *= 0.5
				if math.abs(vn) > 12 and wallT <= 0 then endDrift(false); wallT = 0.6 end
			end
		end
		wallT -= dt
		posY += (y - posY) * math.min(1, dt * 20)
		updateDrift(dt)
		if UserInputService:IsKeyDown(Enum.KeyCode.Backspace) then resetCar() end

		-- HUD
		local kmh = CarPhysics.kmh(S.speed)
		hSpeed.Text = tostring(math.floor(kmh))
		local band = carDef.top / 6
		local gear = math.clamp(math.floor(kmh / band) + 1, 1, 6)
		if S.u < -1 then gear = 0 end
		hGear.Text = gear == 0 and "R" or tostring(gear)
		local rpm = (S.spin or input.hand) and 0.95 or math.clamp((kmh - (gear - 1) * band) / band, 0, 1) * 0.75 + 0.2
		rpmBar.Size = UDim2.new(rpm, 0, 1, 0)
		hCredits.Text = fmt(profile.credits) .. " CR"
		dBox.Visible = drift.active
		if drift.active then
			local pts = drift.score * drift.mult
			dScore.Text = fmt(pts)
			dMult.Text = string.format("×%.1f", drift.mult)
			local tier = "DRIFT"
			for _, t in TIERS do if pts >= t[1] then tier = t[2] end end
			dTier.Text = tier
		end
		mmMe.Position = mmPos(S.x, S.z)
		if toastT > 0 then toastT -= dt; if toastT < 0.5 then toast.TextTransparency = 1 - toastT * 2 end end

		-- tell the server where we are (public map only)
		sendT += dt
		if publicMap and sendT > 0.1 then
			sendT = 0
			R.State:FireServer(S.x, posY, S.z, S.h, carDef.id, drift.active)
		end
	end

	-- place the car on the road, pitched with the slope
	local fx, fz = math.sin(S.h), math.cos(S.h)
	local slope = Track.slope(idx)
	local pos = Vector3.new(S.x, posY, S.z)
	local fwd = Vector3.new(fx, slope, fz).Unit
	local roll = math.clamp(-S.r * CarPhysics.kmh(S.speed) * 0.0006, -0.06, 0.06)
	local cf = CFrame.lookAt(pos, pos + fwd) * CFrame.Angles(0, 0, roll)
	CarModel.place(m, cf, S.delta)

	-- tyre smoke while sliding or spinning
	local smoking = mode == "play" and S.speed > 8 and (math.abs(S.beta) > 0.2 or S.spin)
	if smoking ~= smokeOn then
		smokeOn = smoking
		for _, a in m.PrimaryPart:GetChildren() do
			local e = a:FindFirstChild("Smoke")
			if e then e.Rate = smoking and 45 or 0 end
		end
	end

	-- other players glide to their latest positions; drop anyone silent for 3 s
	for uid, g in ghosts do
		if os.clock() - g.seen > 3 then
			g.model:Destroy(); ghosts[uid] = nil
		else
			g.cf = g.cf:Lerp(g.target, math.min(1, dt * 10))
			CarModel.place(g.model, g.cf, 0)
		end
	end

	-- camera
	if mode ~= "play" then
		orbit += dt * 0.15
		local r = mode == "garage" and 26 or 34
		local eye = pos + Vector3.new(math.sin(S.h + orbit) * r, 9, math.cos(S.h + orbit) * r)
		camera.CFrame = CFrame.lookAt(eye, pos + Vector3.new(0, 3, 0))
		camera.FieldOfView = 55
		CarModel.setCabinVisible(m, true)
	elseif camMode == 2 then
		CarModel.setCabinVisible(m, false)
		local eye = cf * CFrame.new(1.3, 4.0, 0.6)
		camera.CFrame = eye * CFrame.Angles(math.rad(-4), math.clamp(-S.beta * 0.5, -0.6, 0.6), 0)
		camera.FieldOfView = math.clamp(70 + CarPhysics.kmh(S.speed) * 0.08, 70, 88)
	else
		CarModel.setCabinVisible(m, true)
		local sp2 = S.speed
		local dx, dz = fx, fz
		if sp2 > 10 then
			local vx, vz = S.vx / sp2, S.vz / sp2
			dx, dz = fx * 0.45 + vx * 0.55, fz * 0.45 + vz * 0.55
			local l = math.sqrt(dx * dx + dz * dz)
			dx, dz = dx / l, dz / l
		end
		local dist = camMode == 1 and 34 or 22
		local hgt = camMode == 1 and 12 or 7.5
		local target = pos - Vector3.new(dx, 0, dz) * (dist + sp2 * 0.04) + Vector3.new(0, hgt, 0)
		if (camPos - target).Magnitude > 120 then camPos = target end
		camPos = camPos:Lerp(target, math.min(1, dt * 6))
		camera.CFrame = CFrame.lookAt(camPos, pos + Vector3.new(fx, 0, fz) * 8 + Vector3.new(0, 3, 0))
		camera.FieldOfView = math.clamp(62 + CarPhysics.kmh(sp2) * 0.12, 62, 85)
	end
end)

setMode("menu")
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
