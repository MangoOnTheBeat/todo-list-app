{
  "name": "KaidoDrift",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "KaidoServer": { "$path": "src/server/Main.server.luau" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "KaidoClient": { "$path": "src/client" }
      }
    },
    "Players": {
      "$properties": { "CharacterAutoLoads": false }
    },
    "Lighting": {
      "$properties": { "Technology": "Future", "ClockTime": 0, "GlobalShadows": true }
    },
    "Workspace": {
      "$properties": { "StreamingEnabled": true, "StreamingTargetRadius": 1400, "StreamingMinRadius": 300 }
    },
    "TextChatService": {
      "$properties": { "ChatVersion": "TextChatService" }
    }
  }
}
